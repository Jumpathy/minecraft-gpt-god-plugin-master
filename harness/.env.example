# Optional: copy to harness/.env. Real environment variables take precedence. Every value has a
# working default on the development machine; set only what differs.

# The local sandbox server folder (paper.jar, eula.txt, plugins/...). Default: <repo>/../minecraft/srv1
# GOD_SANDBOX_DIR=C:\Users\you\minecraft\srv1
# GOD_SERVER_XMX=4G
# Java 25 for the server and the camera client (default: newest JDK 25+ found under Program Files / ~/.gradle/jdks)
# GOD_JAVA=C:\Program Files\Java\jdk-25\bin\java.exe

# The camera client (the installed vanilla Minecraft)
# GOD_CLIENT_MCDIR=C:\Users\you\AppData\Roaming\.minecraft
# GOD_CLIENT_VERSION=26.3
# GOD_CAMERA_NAME=HarnessCam
# GOD_CLIENT_WIDTH=1280
# GOD_CLIENT_HEIGHT=720

# Bots: by default they join the sandbox. Set these to test a remote server instead.
# GOD_MC_HOST=192.168.1.50
# GOD_MC_PORT=25565
# GOD_MC_VERSION=auto

# Bridge: by default read from <sandbox>/plugins/gptgodmc/bridge.json. For a remote server:
# GOD_BRIDGE_URL=http://192.168.1.50:8765
# GOD_BRIDGE_TOKEN=paste-token-from-bridge.json

# Where screenshots and god views are saved (default harness/out)
# GOD_OUT_DIR=
